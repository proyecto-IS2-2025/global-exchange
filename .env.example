# ══════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE EJEMPLO PARA GLOBAL EXCHANGE
# ══════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa con tus valores reales

# ══════════════════════════════════════════════════════════════════════
# DJANGO CORE
# ══════════════════════════════════════════════════════════════════════

# ⚠️ IMPORTANTE: Genera una nueva SECRET_KEY para producción
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion

# Modo debug (False en producción)
DEBUG=False

# Hosts permitidos (separados por coma, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com,tu-app.onrender.com

# ══════════════════════════════════════════════════════════════════════
# BASE DE DATOS (PostgreSQL)
# ══════════════════════════════════════════════════════════════════════

# Para desarrollo local:
DB_NAME=global_exchange
DB_USER=django_user
DB_PASSWORD=django123
DB_HOST=localhost
DB_PORT=5432

# Para Render (usa DATABASE_URL automáticamente):
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

# ══════════════════════════════════════════════════════════════════════
# EMAIL (Gmail SMTP)
# ══════════════════════════════════════════════════════════════════════

EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail

# ⚠️ Para Gmail, necesitas generar una "App Password":
# 1. Ve a https://myaccount.google.com/security
# 2. Activa verificación en 2 pasos
# 3. Genera una contraseña de aplicación
# 4. Usa esa contraseña aquí (NO tu contraseña normal)

# ══════════════════════════════════════════════════════════════════════
# STRIPE (Pagos)
# ══════════════════════════════════════════════════════════════════════

# Claves de prueba (test)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Para producción, usa las claves live:
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ══════════════════════════════════════════════════════════════════════
# LOGS
# ══════════════════════════════════════════════════════════════════════

DJANGO_LOG_LEVEL=INFO
